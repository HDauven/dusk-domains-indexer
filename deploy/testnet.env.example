# Dusk Domains indexer runtime
NODE_ENV=production
DUSK_DOMAINS_INDEXER_RATE_LIMIT=true
DUSK_DOMAINS_INDEXER_RATE_LIMIT_MAX=200
DUSK_DOMAINS_INDEXER_RATE_LIMIT_WINDOW_MS=60000
DUSK_DOMAINS_INDEXER_TRUST_PROXY=true
DUSK_DOMAINS_INDEXER_ALLOW_PUBLIC_PROXY_TRUST=false
DUSK_DOMAINS_INDEXER_HOST=127.0.0.1
DUSK_DOMAINS_INDEXER_PORT=8788
DUSK_DOMAINS_INDEXER_CORS_ORIGINS=https://testnet.dusk.domains
DUSK_DOMAINS_INDEXER_HEALTH_URL=http://127.0.0.1:8788/health

DUSK_DOMAINS_SITE_URL=https://testnet.dusk.domains
DUSK_DOMAINS_NOINDEX=true
DUSK_DOMAINS_INDEXER_SOURCE_COMMIT=

# Persistent read-model inputs and state
DUSK_DOMAINS_INDEXER_DATA_DIR=/var/lib/dusk-domains/testnet
DUSK_DOMAINS_INDEXER_EVENT_LOG=/var/lib/dusk-domains/testnet/events.jsonl
DUSK_DOMAINS_INDEXER_SQLITE=/var/lib/dusk-domains/testnet/indexer.sqlite
DUSK_DOMAINS_INDEXER_CURSOR=/var/lib/dusk-domains/testnet/cursor.json
DUSK_DOMAINS_INDEXER_CHECKPOINT=/var/lib/dusk-domains/testnet/checkpoint.json

# Health and monitoring policy
DUSK_DOMAINS_INDEXER_MAX_LAG_BLOCKS=12
DUSK_DOMAINS_INDEXER_MAX_SOURCE_AGE_MINUTES=10
DUSK_DOMAINS_INDEXER_ALERT_WEBHOOK_URL=

# Backup policy
DUSK_DOMAINS_INDEXER_BACKUP_DIR=/var/backups/dusk-domains/testnet
DUSK_DOMAINS_INDEXER_BACKUP_RESTORE_DIR=/tmp/dusk-domains-indexer-testnet-restore

# Collector: deployment env holds contract IDs; drivers must match those contracts.
# The start height is the first deployment block, not the current chain head.
DUSK_DOMAINS_COLLECTOR_NODE_URL=http://127.0.0.1:8080
DUSK_DOMAINS_COLLECTOR_DRIVER_DIR=/var/lib/dusk-domains/testnet/release/contracts

# Deployment evidence: replace these paths with the artifacts for this network.
DUSK_DOMAINS_DEPLOYMENT_ENV_FILE=/var/lib/dusk-domains/testnet/release/indexer.env
DUSK_DOMAINS_DEPLOYMENT_PROOF=/var/lib/dusk-domains/testnet/deployment-proof.json
DUSK_DOMAINS_ARCHIVE_SNAPSHOT=/var/lib/dusk-domains/testnet/archive-snapshot.marker.json
DUSK_DOMAINS_ARCHIVE_SNAPSHOT_HEIGHT=

# The deployment's indexer.env supplies these values; do not use legacy router/core/treasury IDs.
# DUSK_DOMAINS_NODE_URL=https://<archive-node>/
# DUSK_DOMAINS_CHAIN_ID=dusk:<network-id>
# DUSK_DOMAINS_FROM_BLOCK=<first-deployment-block>
# DUSK_DOMAINS_EVENT_SCHEMA_VERSION=1
# DUSK_DOMAINS_DIRECTORY_CONTRACT_ID=0x<64-hex>
# DUSK_DOMAINS_DIRECTORY_DRIVER_URL=/contracts/<crate>.<sha256>.data-driver.wasm
# DUSK_DOMAINS_POLICY_CONTRACT_ID=0x<64-hex>
# DUSK_DOMAINS_POLICY_DRIVER_URL=/contracts/<crate>.<sha256>.data-driver.wasm
# DUSK_DOMAINS_STORE_CONTRACT_ID=0x<64-hex>
# DUSK_DOMAINS_STORE_DRIVER_URL=/contracts/<crate>.<sha256>.data-driver.wasm
# DUSK_DOMAINS_VAULT_CONTRACT_ID=0x<64-hex>
# DUSK_DOMAINS_VAULT_DRIVER_URL=/contracts/<crate>.<sha256>.data-driver.wasm
# DUSK_DOMAINS_RESOLVER_CONTRACT_ID=0x<64-hex>
# DUSK_DOMAINS_RESOLVER_DRIVER_URL=/contracts/<crate>.<sha256>.data-driver.wasm
# DUSK_DOMAINS_MARKETPLACE_CONTRACT_ID=0x<64-hex>
# DUSK_DOMAINS_MARKETPLACE_DRIVER_URL=/contracts/<crate>.<sha256>.data-driver.wasm
