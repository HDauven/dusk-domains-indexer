# Written for the Caddy 2.6 in Ubuntu 24.04, whose snippets take {args.N}; Caddy 2.7 and
# later spell them {args[N]}.
(dusk_domains_site) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}

	@webmanifest path /site.webmanifest
	header @webmanifest Content-Type "application/manifest+json"

	# Hashed bundles and versioned data drivers never change; pages and manifests revalidate.
	@hashed path /assets/* /contracts/deployments/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@media path /fonts/* *.png *.svg *.ico
	header @media Cache-Control "public, max-age=86400"
	@pages not path /assets/* /contracts/deployments/* /fonts/* *.png *.svg *.ico /api/*
	header @pages Cache-Control "no-cache"

	@staticAssets path /assets/* /contracts/*

	route {
		# IndexNow ownership keys must be reachable at the site root.
		@indexNow {
			path_regexp indexNowKey ^/([A-Za-z0-9-]{8,128})\.txt$
			not file {
				root {args.0}
				try_files {path}
			}
		}
		rewrite @indexNow /api/indexnow/{re.indexNowKey.1}.txt

		# Link-preview crawlers get the indexer's share card for a name page; browsers get the app.
		@namePage path /name/*
		header @namePage {
			+Vary User-Agent
			defer
		}
		@preview {
			path_regexp shareName ^/name/(.+)$
			header_regexp User-Agent (?i)(facebookexternalhit|facebot|twitterbot|slackbot|discordbot|linkedinbot|telegrambot|whatsapp|applebot|embedly|pinterestbot|skypeuripreview|google-inspectiontool)
		}
		rewrite @preview /api/share/name/{re.shareName.1}

		# AI crawlers do not run JavaScript; they get the indexer's plain page for the name.
		@crawler {
			path_regexp crawlName ^/name/(.+)$
			header_regexp User-Agent (?i)(gptbot|oai-searchbot|chatgpt-user|claudebot|claude-searchbot|claude-user|anthropic-ai|perplexitybot|perplexity-user|ccbot|meta-externalagent|amazonbot|duckassistbot|mistralai-user|youbot|cohere-ai)
		}
		rewrite @crawler /api/page/name/{re.crawlName.1}
		rewrite /sitemap-names.xml /api/sitemap/names.xml

		handle_path /api/* {
			reverse_proxy {args.1}
		}

		handle @staticAssets {
			root * {args.0}
			file_server
		}

		handle {
			root * {args.0}
			try_files {path} /index.html
			file_server
		}
	}
}

# One canonical host: www redirects instead of serving a duplicate site.
www.dusk.domains {
	redir https://dusk.domains{uri} permanent
}

dusk.domains {
	import dusk_domains_site /srv/dusk-domains/dist 127.0.0.1:8787
}

api.dusk.domains {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	reverse_proxy 127.0.0.1:8787
}

testnet.dusk.domains {
	header {
		X-Robots-Tag "noindex, nofollow"
		defer
	}
	import dusk_domains_site /srv/dusk-domains-testnet/dist 127.0.0.1:8788
}
